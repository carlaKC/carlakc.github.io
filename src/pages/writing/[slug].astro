---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
// Reading time: visible prose at 230 wpm, plus time to look at charts and use interactives
const body = post.body ?? '';
const prose = body
  .replace(/<script[\s\S]*?<\/script>/g, ' ')
  .replace(/\]\([^)]*\)/g, ']')
  .replace(/<[^>]+>/g, ' ');
const words = prose.split(/\s+/).filter((w) => /\w/.test(w)).length;
const images = (body.match(/<img\b/g) ?? []).length;
const interactives = (body.match(/<iframe\b/g) ?? []).length;
const minutes = Math.max(1, Math.round(words / 230 + images * 0.25 + interactives * 1.5));
---
<Base title={`${post.data.title} — Carla Kirk-Cohen`} description={post.data.description} wide background="/blog-background.webp" noindex={post.data.unlisted}>
  <header class="post-hero reveal">
    <div class="wrap">
      <p class="eyebrow">
        {post.data.draft && <span class="draft">Draft</span>}
        Long post
      </p>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="byline">{post.data.description}</p>}
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{dateStr}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
    </div>
  </header>

  <div class="sheet">
    <article class="wrap post-body">
      <div class="prose">
        <Content />
      </div>
      <p class="post-end"><a href="/#writing">&larr; More writing</a></p>
    </article>
  </div>

  <style>
    /* Title over the artwork, echoing the home intro. Sized by its content
       (not the viewport) so the post starts right below the title. */
    .post-hero .wrap {
      --hero-top: clamp(7rem, 14vh, 9.5rem); /* clears the overlay header */
      position: relative;
      padding-block: var(--hero-top) 2.75rem;
    }
    /* soft cream scrim so the type stays legible over the artwork */
    .post-hero .wrap::before {
      content: "";
      position: absolute;
      inset: calc(var(--hero-top) - 1.5rem) -1rem 1.25rem;
      z-index: -1;
      background: var(--paper);
      opacity: 0.3;
      filter: blur(34px);
      border-radius: 44px;
    }
    .post-hero .wrap > * { position: relative; }
    .draft {
      margin-right: 0.8rem;
      padding: 0.15rem 0.5rem;
      border: 1px solid currentColor;
      border-radius: 3px;
    }
    .post-hero h1 {
      max-width: 48rem;
      font-size: clamp(2.2rem, 4vw + 1rem, 3.3rem);
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 1.06;
    }
    .byline {
      margin: 1.3rem 0 0;
      max-width: 40rem;
      color: var(--terracotta-ink);
      font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.28rem);
      line-height: 1.5;
    }
    .post-meta {
      display: flex;
      gap: 0.6rem;
      margin: 1.6rem 0 0;
      font-size: 0.82rem;
      letter-spacing: 0.02em;
      color: #4a4038;
    }

    /* roomier inner padding on the full-width sheet */
    .post-body {
      padding-top: clamp(2.6rem, 6vw, 4rem);
      padding-inline: clamp(1.25rem, 5vw, 4.5rem);
    }

    /* ---- long-form prose ---- */
    .prose { line-height: 1.78; }
    .prose > :global(p:first-child) {
      font-size: 1.14em;
      line-height: 1.7;
      color: var(--ink);
    }
    .prose :global(h2) {
      margin: 3.2rem 0 1rem;
      font-size: 1.5rem;
      line-height: 1.25;
    }
    .prose :global(h3) {
      margin: 2.4rem 0 0.8rem;
      font-size: 1.2rem;
      line-height: 1.3;
    }
    .prose :global(a) { text-decoration: underline; text-decoration-thickness: 1px; }

    /* "#" link beside each heading, so readers can link to a section */
    .prose :global(:is(h2, h3)[id]) { scroll-margin-top: 1.5rem; }
    .prose :global(.heading-anchor) {
      margin-left: 0.4em;
      color: var(--muted);
      font-weight: 400;
      text-decoration: none;
      opacity: 0;
      transition: opacity 0.2s ease, color 0.2s ease;
    }
    .prose :global(:is(h2, h3):hover .heading-anchor),
    .prose :global(.heading-anchor:focus-visible) { opacity: 1; }
    .prose :global(.heading-anchor:hover) { color: var(--terracotta); }
    @media (hover: none) { .prose :global(.heading-anchor) { opacity: 0.5; } }

    /* "Share your intuition" prompt under an interactive */
    .prose :global(.share-prompt) { position: relative; margin-top: 1.6rem; color: var(--muted); }
    .prose :global(.share-link) {
      font: inherit;
      color: var(--terracotta-ink);
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
      transition: color 0.4s ease;
    }
    .prose :global(.share-link:hover) { color: var(--terracotta); }
    .prose :global(.share-link:focus-visible) { outline: 2px solid var(--terracotta); outline-offset: 2px; }
    .prose :global(.share-toast) {
      display: inline-block;
      margin-left: 0.7rem;
      padding: 0.1rem 0.6rem;
      font-size: 0.8rem;
      color: var(--paper);
      background: #253b55;
      border-radius: 3px;
      opacity: 0;
      transform: translateY(3px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      pointer-events: none;
    }
    .prose :global(.share-toast:empty) { display: none; }
    .prose :global(.share-toast.show) { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) { .prose :global(.share-toast) { transition: none; } }

    .prose :global(ul),
    .prose :global(ol) { margin: 0 0 1.4rem; padding-left: 1.4rem; }
    .prose :global(li) { margin-bottom: 0.45rem; padding-left: 0.3rem; }
    .prose :global(li::marker) { color: var(--terracotta-ink); }

    .prose :global(blockquote) {
      margin: 2rem 0;
      padding: 0.2rem 0 0.2rem 1.5rem;
      border-left: 2px solid var(--terracotta);
      color: var(--terracotta-ink);
      font-size: 1.12em;
      line-height: 1.6;
    }
    .prose :global(blockquote p:last-child) { margin-bottom: 0; }

    .prose :global(:not(pre) > code) {
      padding: 0.1em 0.35em;
      border-radius: 3px;
      background: var(--paper-2);
      font-size: 0.86em;
    }
    .prose :global(pre) { margin: 1.8rem 0; }

    .prose :global(hr) {
      width: 3rem;
      margin: 3rem auto;
      border: 0;
      border-top: 1px solid var(--terracotta);
    }

    /* images render at their natural size (never upscaled), centered */
    .prose :global(img) {
      display: block;
      max-width: 100%;
      height: auto;
      margin-inline: auto;
      border: 1px solid var(--hairline-strong);
      border-radius: 3px;
    }
    .prose :global(figure) { margin: 2.4rem 0; }
    .prose :global(figcaption) {
      margin-top: 0.7rem;
      text-align: center;
      font-size: 0.82rem;
      color: var(--muted);
    }

    /* "Decision" callouts: the author's take at the end of a section */
    .prose :global(.decision) {
      margin: 2.6rem 0;
      padding: 1.5rem 1.7rem 0.4rem;
      background: var(--paper-2);
      border-left: 2px solid var(--terracotta);
      border-radius: 0 4px 4px 0;
    }
    .prose :global(.decision-label) {
      margin: 0 0 0.6rem;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--terracotta-ink);
    }
    .prose :global(.decision strong) { font-size: 1.08em; }

    .prose :global(table) {
      width: 100%;
      margin: 2rem 0;
      border-collapse: collapse;
      font-size: 0.92em;
    }
    .prose :global(th),
    .prose :global(td) {
      padding: 0.6rem 0.8rem 0.6rem 0;
      border-bottom: 1px solid var(--hairline);
      text-align: left;
    }
    .prose :global(th) {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      border-bottom-color: var(--hairline-strong);
    }

    /* GFM footnotes */
    .prose :global(sup a) { text-decoration: none; }
    .prose :global(.footnotes) {
      margin-top: 3.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--hairline);
      font-size: 0.86rem;
      color: var(--muted);
    }
    .prose :global(.footnotes h2) {
      margin: 0 0 1rem;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    /* acknowledgements: small, set apart from the end of the post */
    .prose :global(.thanks) {
      margin: 3rem 0 0;
      font-size: 0.86rem;
      line-height: 1.6;
      color: var(--muted);
    }

    .post-end {
      margin: 3.5rem 0 0;
      padding-top: 1.6rem;
      border-top: 1px solid var(--hairline);
      font-size: 0.82rem;
      letter-spacing: 0.04em;
    }
    .post-end a { color: var(--muted); }
    .post-end a:hover { color: var(--terracotta); text-decoration: none; }
  </style>

  <script>
    // Headings already have ids; add a visible "#" link to each one
    document.querySelectorAll(".prose :is(h2, h3)[id]").forEach((h) => {
      if (h.closest(".footnotes")) return;
      const a = document.createElement("a");
      a.className = "heading-anchor";
      a.href = `#${h.id}`;
      a.setAttribute("aria-label", `Link to “${h.textContent.trim()}”`);
      a.textContent = "#";
      h.append(a);
    });
  </script>
</Base>
